datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model Routine {
  id        String   @id @default(cuid())
  userId    String
  weekStart String   // YYYY-MM-DD of the Monday in ART; identifier, not a timestamp
  status    String   @default("active") // "draft" | "pending_approval" | "active" | "archived"
  createdAt DateTime @default(now())

  days      DailyWorkout[]
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model BodyWeight {
  id        String   @id @default(cuid())
  userId    String
  date      DateTime
  weight    Float    // kg
  bodyFat   Float?   // porcentaje
  muscle    Float?   // porcentaje
  scaleId   Int?
  notes     String?
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, scaleId])
}

model DailyWorkout {
  id          String   @id @default(cuid())
  routineId   String
  dayOfWeek   String
  date        DateTime?
  type        String   // 'Gym', 'Cycling', 'Rest'

  // Cycling summary (for quick display + legacy). Structured detail lives in `blocks`.
  targetDuration Int?    // total minutes including warmup, intervals, cooldown
  targetPower    String? // summary label, e.g. "Z2" or "Z2 + 4xZ4"

  notes          String?

  routine     Routine @relation(fields: [routineId], references: [id], onDelete: Cascade)
  exercises   Exercise[]
  completions WorkoutCompletion[]
  blocks      CyclingBlock[]
}

model CyclingBlock {
  id               String   @id @default(cuid())
  dailyWorkoutId   String
  order            Int      // sequence within the workout (0, 1, 2, ...)
  kind             String   // "warmup" | "steady" | "interval" | "cooldown"
  duration         Int      // minutes (for kind="interval" this is the duration of each rep)
  targetPower      String   // "Z1", "Z2", "Z4", "85%FTP", etc

  // Only meaningful for kind="interval" — compressed form of "Nx{duration}min {targetPower} / {recoveryDuration}min {recoveryPower}"
  repetitions      Int?
  recoveryDuration Int?
  recoveryPower    String?

  notes            String?

  dailyWorkout     DailyWorkout @relation(fields: [dailyWorkoutId], references: [id], onDelete: Cascade)

  @@index([dailyWorkoutId, order])
}

model WorkoutCompletion {
  id             String    @id @default(cuid())
  dailyWorkoutId String
  weekStart      String    // YYYY-MM-DD of the Monday in ART; identifier, not a timestamp
  completed      Boolean   @default(false)
  creatineTaken  Boolean   @default(false)
  completedAt    DateTime?

  dailyWorkout DailyWorkout @relation(fields: [dailyWorkoutId], references: [id], onDelete: Cascade)

  @@unique([dailyWorkoutId, weekStart])
}

model Exercise {
  id             String   @id @default(cuid())
  dailyWorkoutId String
  
  name           String
  targetSets     Int
  targetReps     String?  
  
  dailyWorkout   DailyWorkout @relation(fields: [dailyWorkoutId], references: [id], onDelete: Cascade)
  logs           WorkoutLog[]
}

model WorkoutLog {
  id         String   @id @default(cuid())
  exerciseId String
  
  setNumber  Int
  reps       Int
  weight     Float    
  
  exercise   Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
}

// NextAuth models
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  password      String?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Strava integration
  stravaAthleteId    String?
  stravaAccessToken  String?
  stravaRefreshToken String?
  stravaTokenExpiry  Int?     // Unix timestamp

  accounts      Account[]
  sessions      Session[]
  routines      Routine[]
  bodyWeights   BodyWeight[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
