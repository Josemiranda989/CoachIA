datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model Routine {
  id        String   @id @default(cuid())
  userId    String
  weekStart String   // YYYY-MM-DD of the Monday in ART; identifier, not a timestamp
  status    String   @default("active") // "draft" | "pending_approval" | "active" | "archived"
  createdAt DateTime @default(now())

  days      DailyWorkout[]
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model BodyWeight {
  id        String   @id @default(cuid())
  userId    String
  date      DateTime
  weight    Float    // kg
  bodyFat   Float?   // porcentaje
  muscle    Float?   // porcentaje
  notes     String?
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
}

model DailyWorkout {
  id          String   @id @default(cuid())
  routineId   String
  dayOfWeek   String
  date        DateTime?
  type        String   // 'Gym', 'Cycling', 'Rest'

  // Cycling summary (for quick display + legacy). Structured detail lives in `blocks`.
  targetDuration Int?    // total minutes including warmup, intervals, cooldown
  targetPower    String? // summary label, e.g. "Z2" or "Z2 + 4xZ4"

  notes          String?

  // Hevy sync: id of the mirror Routine in Hevy (api.hevyapp.com). Populated
  // after first successful sync; enables UPDATE instead of duplicate CREATE.
  hevyRoutineId  String?

  routine     Routine @relation(fields: [routineId], references: [id], onDelete: Cascade)
  exercises   Exercise[]
  completions WorkoutCompletion[]
  blocks      CyclingBlock[]
}

model HevyExerciseMapping {
  id             String   @id @default(cuid())
  coachiaName    String   @unique
  hevyTemplateId String
  hevyTitle      String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// Stable mapping of a user's gym "slot" (Día 1/2/3 of the mesocycle) to a single
// persistent Hevy routine. The gym template is identical across the 4 weeks of a
// mesocycle AND reused month over month, so each slot maps to ONE Hevy routine that
// gets PUT-updated each mesocycle — instead of POSTing 12 throwaway routines (3
// gym days × 4 weeks) that then pile up as "OLD" archives.
model HevyGymSlot {
  id            String   @id @default(cuid())
  userId        String
  slotIndex     Int      // 1-based position among the week's gym days (Día 1, 2, 3...)
  hevyRoutineId String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([userId, slotIndex])
}

// Wiki-style reference for each canonical exercise name. One row per canonical
// exercise, independent of Routine/DailyWorkout. Keyed by `name` (must match the
// normalized name used in `Exercise.name`).
model ExerciseDefinition {
  id           String   @id @default(cuid())
  name         String   @unique // canonical exercise name (matches Exercise.name)
  slug         String   @unique // URL-safe, e.g. "face-pull"
  description  String   // short "what is this exercise" paragraph
  muscleGroups String   // comma-separated primary+secondary, e.g. "Espalda media, Deltoides posterior"
  instructions String   // step-by-step execution, newline-separated
  tips         String?  // coaching cues / common mistakes, newline-separated
  equipment    String?  // "Polea", "Mancuernas", "Barra", "Peso corporal", etc.
  imagePath    String?  // path under /public, e.g. "/exercises/face-pull.png"
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model CyclingBlock {
  id               String   @id @default(cuid())
  dailyWorkoutId   String
  order            Int      // sequence within the workout (0, 1, 2, ...)
  kind             String   // "warmup" | "steady" | "interval" | "cooldown"
  duration         Int      // minutes (for kind="interval" this is the duration of each rep)
  targetPower      String   // "Z1", "Z2", "Z4", "85%FTP", etc

  // Only meaningful for kind="interval" — compressed form of "Nx{duration}min {targetPower} / {recoveryDuration}min {recoveryPower}"
  repetitions      Int?
  recoveryDuration Int?
  recoveryPower    String?

  // Optional cadence target (rpm). Examples: "85-95 rpm", "100+ rpm spin-up",
  // "60-65 rpm big gear". When null, the block has no cadence prescription.
  targetCadence    String?

  notes            String?

  dailyWorkout     DailyWorkout @relation(fields: [dailyWorkoutId], references: [id], onDelete: Cascade)

  @@index([dailyWorkoutId, order])
}

// Snapshot previo a cada mutación aplicada desde el Chat Coach. Permite
// deshacer restaurando los DailyWorkout/CyclingBlock afectados (beforeJson).
model RoutineChangeLog {
  id         String    @id @default(cuid())
  routineId  String
  summary    String    // ej "Jueves → Z2 (60 min)"
  beforeJson String    // DaySnapshot[] de los días afectados
  undoneAt   DateTime?
  createdAt  DateTime  @default(now())

  @@index([routineId, createdAt])
}

model WorkoutCompletion {
  id             String    @id @default(cuid())
  dailyWorkoutId String
  weekStart      String    // YYYY-MM-DD of the Monday in ART; identifier, not a timestamp
  completed      Boolean   @default(false)
  creatineTaken  Boolean   @default(false)
  completedAt    DateTime?

  dailyWorkout DailyWorkout @relation(fields: [dailyWorkoutId], references: [id], onDelete: Cascade)

  @@unique([dailyWorkoutId, weekStart])
}

model Exercise {
  id             String   @id @default(cuid())
  dailyWorkoutId String

  name           String
  targetSets     Int
  targetReps     String?
  // Direct Hevy template id when Gemini picked the exercise from Hevy's library.
  // When null, hevy-sync falls back to the legacy name-based HevyExerciseMapping.
  hevyTemplateId String?

  dailyWorkout   DailyWorkout @relation(fields: [dailyWorkoutId], references: [id], onDelete: Cascade)
  logs           WorkoutLog[]
}

model WorkoutLog {
  id         String   @id @default(cuid())
  exerciseId String
  weekStart  String

  setNumber  Int
  reps       Int
  weight     Float

  exercise   Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  @@unique([exerciseId, setNumber, weekStart])
  @@index([weekStart])
}

// ─── Strava Activity Cache ──────────────────────────────────────────────────
// Mirrors Strava activities in our DB so stats endpoints don't hit Strava on
// every request. Sync happens every 30 min via /api/strava/sync (called by
// cron script). userId + stravaId are unique — upsert on re-sync.

model CachedActivity {
  id                String   @id @default(cuid())
  userId            String
  stravaId          BigInt
  name              String
  type              String   // Ride, VirtualRide, etc.
  startDate         DateTime
  timezone          String?
  distance          Float    // meters
  movingTime        Int      // seconds
  elapsedTime       Int      // seconds
  totalElevationGain Float?
  averageSpeed      Float?
  maxSpeed          Float?
  averageHeartrate  Float?
  maxHeartrate      Float?
  averageCadence    Float?
  averageWatts      Float?
  maxWatts          Float?
  sufferScore       Int?
  kilojoules        Float?
  averageTemp       Float?
  elevHigh          Float?
  elevLow           Float?
  deviceName        String?
  prCount           Int?
  achievementCount  Int?
  rawJson           String   // full Strava response for future hydration

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, stravaId])
  @@index([userId, startDate])
  @@index([userId, type, startDate])
}

// ─── Pre-computed Aggregates ──────────────────────────────────────────────────
// Computed after each Strava sync so dashboards and cron scripts read a single
// row instead of scanning the full activity table.

model CyclingWeeklyAggregate {
  id           String   @id @default(cuid())
  userId       String
  weekStart    String   // YYYY-MM-DD of the Monday in ART
  totalRides   Int
  totalKm      Float
  totalHours   Float
  totalKj      Float
  totalKcal    Float
  totalTSS     Float
  totalElevation Float
  avgHR        Float?
  avgPower     Float?
  avgCadence   Float?
  avgTemp      Float?
  maxHeartrate Float?
  maxSpeed     Float?
  maxWatts     Float?
  avgIntensity Float?   // avgHR / maxHR ratio

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([userId, weekStart])
  @@index([userId, weekStart])

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CyclingMonthlyAggregate {
  id           String   @id @default(cuid())
  userId       String
  month        String   // YYYY-MM
  totalRides   Int
  totalKm      Float
  totalHours   Float
  totalKj      Float
  totalKcal    Float
  totalTSS     Float
  totalElevation Float
  avgHR        Float?
  avgPower     Float?
  avgCadence   Float?
  avgTemp      Float?
  maxHeartrate Float?
  maxSpeed     Float?
  maxWatts     Float?
  avgIntensity Float?

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([userId, month])
  @@index([userId, month])

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─── Sync Tracker ─────────────────────────────────────────────────────────────
// Tracks the last successful sync so we know whether data is stale.

model StravaSyncState {
  id           String   @id @default(cuid())
  userId       String   @unique
  lastSyncAt   DateTime
  lastActivityStartDate DateTime?
  totalCached  Int      @default(0)

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// NextAuth models
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  password      String?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Strava integration
  stravaAthleteId    String?
  stravaAccessToken  String?
  stravaRefreshToken String?
  stravaTokenExpiry  Int?     // Unix timestamp

  // Heart rate config used to resolve "Z1"-"Z7" labels into actionable bpm
  // ranges on the BSC300T. lthr (Lactate Threshold HR) takes precedence when
  // set; fcMax is the fallback. Without either, exports fall back to FIT
  // zone references which the device renders only if its own HR zones are
  // configured.
  fcMax Int?
  lthr  Int?

  // Functional Threshold Power (watts) for cycling — used by fitness
  // calculations (TSS normalization, CTL/ATL/TSB).
  ftp   Int?

  accounts                 Account[]
  sessions                 Session[]
  routines                 Routine[]
  bodyWeights              BodyWeight[]
  cachedActivities         CachedActivity[]
  cyclingWeeklyAggregates  CyclingWeeklyAggregate[]
  cyclingMonthlyAggregates CyclingMonthlyAggregate[]
  stravaSyncState          StravaSyncState?
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
